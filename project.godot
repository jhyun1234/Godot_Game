[layer_names]

3d_physics/layer_1="지형"
3d_physics/layer_2="플레이어"
3d_physics/layer_3="채굴가능"
3d_physics/layer_4="광석"
3d_physics/layer_5="괴물"

[maaacks_game_template]

disable_install_audio_busses=true
disable_install_wizard=true
main_menu_scene_path="res://addons/scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://scenes/level/Tunnel.tscn"
ending_scene_path="res://addons/scenes/end_credits/end_credits.tscn"
loading_scene_path="res://addons/scenes/loading_screen/loading_screen.tscn"
copy_path="res://addons/"

[physics]

3d/physics_engine="Jolt Physics"

[plugin_updater]

plugins={
"res://addons/maaacks_game_template/": "https://github.com/Maaack/Godot-Game-Template"
}

[rendering]

rendering_device/driver.windows="d3d12"
